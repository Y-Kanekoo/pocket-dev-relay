# 環境設定（development / production）
NODE_ENV=development

PORT=4173
WORKSPACE_ROOT=/Users/ykaneko/Projects/AI-remote-dev
AUTH_TOKEN=change-me
ALLOW_CUSTOM_COMMANDS=false
ALLOW_FILE_WRITE=false
MAX_FILE_SIZE=1048576
CODEX_CMD=codex
CODEX_ARGS=
CLAUDE_CMD=claude
CLAUDE_ARGS=
SHELL_CMD=zsh
SHELL_ARGS=
# リバースプロキシのtrust設定（Cloudflare Tunnel等経由時に設定）
# false=信頼しない / true=すべて信頼 / 数値=プロキシホップ数 / IPアドレス指定も可
TRUST_PROXY=false

# ログレベル（trace/debug/info/warn/error/fatal）
LOG_LEVEL=info

# セッションログ設定
ENABLE_SESSION_LOGS=false
LOG_DIR=

# セッションログの保持日数（デフォルト: 30日）
LOG_MAX_AGE_DAYS=30

# セッションログの最大合計サイズ（MB、デフォルト: 100MB）
LOG_MAX_SIZE_MB=100

# データ永続化
DATA_DIR=                  # データ保存ディレクトリ（デフォルト: ワークスペース/.pocket-dev-relay）

# レート制限設定
# API全体のリクエスト数上限（1分あたり）
RATE_LIMIT_API=100
# 認証失敗の上限（1分あたり、ブルートフォース防止）
RATE_LIMIT_AUTH=5

# セッションタイムアウト設定（ミリ秒、デフォルト1時間）
# 0に設定するとタイムアウト無効
SESSION_TIMEOUT=3600000

# AI設定（オプション - どちらか一方を設定するとAI解析機能が有効になる）
# Anthropic APIキー（Claude使用時）
ANTHROPIC_API_KEY=
# OpenAI APIキー（OpenAI使用時）
OPENAI_API_KEY=
# カスタムモデル指定（オプション）
# デフォルト: Claudeの場合 claude-sonnet-4-5-20250929、OpenAIの場合 gpt-4o
AI_MODEL=
# 送信するターミナル出力の最大行数（デフォルト: 100）
AI_MAX_CONTEXT_LINES=100

# HTTPS設定（オプション）
# ENABLE_HTTPS=true を設定するとHTTPSモードで起動
ENABLE_HTTPS=false
# SSL証明書のパス（HTTPS有効時に必須）
SSL_KEY_PATH=
SSL_CERT_PATH=

# SSH中継設定（オプション）
# ENABLE_SSH=true を設定するとSSH中継機能が有効になる
# パスワードはWebSocket経由で送信されるため、HTTPS推奨
ENABLE_SSH=false
# SSHデフォルト接続先（未指定の場合はダイアログで入力）
SSH_DEFAULT_HOST=
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=
# SSH秘密鍵のパス（デフォルト: ~/.ssh/id_rsa）
SSH_KEY_PATH=
# SSHホスト鍵の厳格な検証（デフォルト: true、falseで無効化）
SSH_STRICT_HOST_KEY=true
# SSHパスワード認証にHTTPSを要求する（デフォルト: true、falseで無効化）
SSH_REQUIRE_HTTPS_FOR_PASSWORD=true

# トンネル設定（外部アクセス）
# ENABLE_TUNNEL=true を設定するとcloudflaredで外部アクセス可能になる
# cloudflaredのインストールが必要: brew install cloudflared
# AUTH_TOKENの設定が必須（インターネット公開のため）
ENABLE_TUNNEL=false
# トンネルプロバイダー（デフォルト: cloudflared）
TUNNEL_PROVIDER=cloudflared
# cloudflaredバイナリパス（PATHに無い場合に指定）
CLOUDFLARED_PATH=
# トンネル起動タイムアウト（ミリ秒、デフォルト: 30秒）
TUNNEL_TIMEOUT=30000
