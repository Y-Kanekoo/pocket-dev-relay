{
  "name": "pocket-dev-relay",
  "version": "0.1.0",
  "description": "スマホからPCのターミナルにアクセスするリモート開発ツール",
  "main": "dist/server.js",
  "bin": {
    "pocket-dev-relay": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client && npm run build:cli",
    "build:server": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js --external:node-pty --external:ssh2 --external:cpu-features --external:pino --external:pino-pretty",
    "build:client": "esbuild src/client/app.ts --bundle --minify --outfile=public/app.js",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --external:node-pty --external:ssh2 --external:cpu-features --external:pino --external:pino-pretty --external:./server.js --banner:js='#!/usr/bin/env node'",
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "start:awake": "caffeinate -dimsu node dist/server.js",
    "watch": "concurrently \"npm run watch:server\" \"npm run watch:client\"",
    "watch:server": "esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js --external:node-pty --external:ssh2 --external:cpu-features --external:pino --external:pino-pretty --watch",
    "watch:client": "esbuild src/client/app.ts --bundle --outfile=public/app.js --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "keywords": [
    "terminal",
    "remote",
    "mobile",
    "development",
    "websocket",
    "pty"
  ],
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y-Kanekoo/pocket-dev-relay.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.0.2",
    "nanoid": "^5.0.5",
    "node-pty": "^1.0.0",
    "pino": "^10.3.0",
    "qrcode": "^1.5.3",
    "ssh2": "^1.17.0",
    "ws": "^8.17.0"
  }
}
