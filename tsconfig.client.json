{
  "compilerOptions": {
    // ターゲット設定（ブラウザ向け）
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2020"],

    // 厳格モード
    "strict": true,
    "noImplicitAny": true,

    // その他の推奨設定
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "sourceMap": true
  },
  "include": [
    "src/client/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ]
}
